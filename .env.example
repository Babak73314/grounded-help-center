# Every variable is optional. With none set, the local server uses the database
# from docker-compose.yml, the local extractive writer and the hashing embedder.

# DATABASE_URL=postgres://help:help@127.0.0.1:5433/help
# PORT=3000

# Claude on Amazon Bedrock writes the answers (needs AWS credentials in the environment):
# MODEL_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
# BEDROCK_FALLBACK_MODEL_ID=
# MODEL_EFFORT=low
# AWS_REGION=

# Titan Text Embeddings V2 on Amazon Bedrock embeds the passages:
# EMBEDDING_PROVIDER=bedrock
# BEDROCK_EMBEDDING_MODEL_ID=

# Limits per caller and for everyone:
# LIMIT_ASK_PER_10_MINUTES=10
# LIMIT_ASK_PER_DAY=40
# LIMIT_DRAFTS_PER_DAY=100
