{
  "name": "grounded-help-center-backend",
  "version": "1.0.0",
  "private": true,
  "description": "The assistant behind the help center: hybrid retrieval in PostgreSQL with pgvector, a deterministic answer check, a local extractive answerer and Claude on Amazon Bedrock behind configuration.",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "start": "tsx src/local/server.ts",
    "test": "vitest run",
    "eval": "vitest run eval",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.0",
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@aws-sdk/client-rds-data": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
